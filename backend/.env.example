# ============================================================
# ResearchPilot AI — backend configuration
# Copy to .env and edit. Every provider is optional; the system
# uses a local Ollama model and live DuckDuckGo search by default.
# ============================================================

# --- LLM provider: ollama | openrouter | offline -------------
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Search provider: tavily | brave | duckduckgo | offline --
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
BRAVE_API_KEY=

# --- Embeddings: local (TF-IDF, zero deps) | sentence_transformers
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Research control -----------------------------------------
MAX_RESEARCH_ITERATIONS=3
MAX_SOURCES_PER_QUERY=5
MAX_QUERIES_PER_ITERATION=4
REQUEST_TIMEOUT_SECONDS=15
MAX_DOCUMENT_CHARS=20000

# --- Storage ----------------------------------------------------
DATABASE_URL=sqlite:///./data/researchpilot.db

# --- Server -------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
